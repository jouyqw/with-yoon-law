/sitemap.xml
  Cache-Control: public, max-age=300, must-revalidate
  X-Robots-Tag: index, follow

/rss.xml
  Cache-Control: public, max-age=300, must-revalidate
  X-Robots-Tag: index, follow

/robots.txt
  Cache-Control: public, max-age=300, must-revalidate
  X-Robots-Tag: index, follow

# IndexNow 인증 키 파일. text/plain 으로 서빙되어야 검증을 통과한다.
/eee764b31941bb288655b49d490b1005.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

/blog/*
  X-Robots-Tag: index, follow

/board*
  X-Robots-Tag: index, follow

# 404 페이지 자체는 색인하지 않는다. 위의 /blog/* 규칙보다 뒤에 두어야
# 없는 주소로 들어온 요청에 index 가 붙지 않는다.
/404.html
  X-Robots-Tag: noindex, follow
