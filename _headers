  Cache-Control: public, max-age=300, must-revalidate
  X-Robots-Tag: index, follow

/rss.xml
  Cache-Control: public, max-age=300, must-revalidate
  X-Robots-Tag: index, follow

/robots.txt
  Cache-Control: public, max-age=300, must-revalidate
  X-Robots-Tag: index, follow

# IndexNow 인증 키 파일. text/plain 으로 서빙되어야 검증을 통과한다.
/eee764b31941bb288655b49d490b1005.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

# /blog/* 와 /board* 에 X-Robots-Tag: index, follow 를 걸어 두었으나 제거한다.
# 이 규칙은 요청 경로로 매칭되기 때문에 없는 주소로 들어온 404 응답에까지
# index 가 붙었다. 색인하지 말라고 404 를 주면서 색인하라는 헤더를 같이
# 보내는 꼴이었다. 모든 글 페이지가 이미 <meta name="robots"> 를 갖고 있고
# 헤더가 없어도 크롤러 기본값이 index 이므로 잃는 것은 없다.
